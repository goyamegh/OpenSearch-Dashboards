{
  "benchmark_name": "Text-to-PPL Conversion",
  "version": "1.0.0",
  "description": "Evaluates agent's ability to convert natural language queries to valid PPL syntax",
  "test_cases": [
    {
      "id": "text-to-ppl-001",
      "category": "text-to-ppl",
      "subcategory": "basic-filter",
      "difficulty": "easy",
      "tags": ["filter", "equality"],
      "input": {
        "query": "Generate a PPL query to show all logs where level is ERROR",
        "context": {
          "task": "generate_ppl_query",
          "index": "ss4o_logs-*",
          "available_fields": ["timestamp", "level", "message", "service", "host"],
          "field_types": {
            "timestamp": "date",
            "level": "keyword",
            "message": "text",
            "service": "keyword",
            "host": "keyword"
          }
        }
      },
      "expected_output": {
        "ppl_query": "source=ss4o_logs-* | where level='ERROR'",
        "tools_used": ["ppl_generator"],
        "reasoning": "Simple equality filter on level field"
      },
      "evaluation_criteria": {
        "primary_metric": "syntax_valid",
        "syntax_valid": true,
        "semantically_correct": true,
        "optimal_query": true
      }
    },
    {
